APP_NAME=Manutencao Prescritiva Enterprise
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
DATABASE_URL=postgresql+asyncpg://maintenance:maintenance@db:5432/maintenance
SYNC_DATABASE_URL=postgresql+psycopg://maintenance:maintenance@db:5432/maintenance

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=600

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
DOCUMENT_MIN_SIMILARITY=0.42
EVENT_SIMILARITY_LIMIT=20
EVENT_MAX_DISTANCE=0.60
HYBRID_VECTOR_WEIGHT=0.70
HYBRID_TEXT_WEIGHT=0.30

LLM_PROVIDER=template
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60

MODEL_ARTIFACT_DIR=artifacts
BANNER_CSV_PATH=data/banner.csv
DOCUMENTS_DIR=data/documents
API_URL=http://api:8000

ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
